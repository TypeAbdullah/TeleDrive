# ─── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Base URL for the frontend application
FRONTEND_URL=http://localhost:5173
# Base URL for the backend API (also used by Better Auth as BETTER_AUTH_URL)
API_BASE_URL=http://localhost:3000
# Trust reverse proxy (e.g. Cloudflare / Nginx) for client IP resolution
TRUST_PROXY=true

# ─── Better Auth ────────────────────────────────────────────────────────────────
# Secret used by Better Auth to sign tokens/sessions (min 32 characters)
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars
# Better Auth base URL (should match API_BASE_URL)
BETTER_AUTH_URL=http://localhost:3000

# ─── Discord OAuth ──────────────────────────────────────────────────────────────
# Obtain from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI: http://localhost:3000/api/auth/callback/discord

# ─── MongoDB Atlas (SRV) ───────────────────────────────────────────────────────
# Use your MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/teledrive?retryWrites=true&w=majority
MONGODB_DB_NAME=teledrive

# ─── Redis (Optional — required for distributed mode) ───────────────────────────
# Set to empty or omit to run in single-instance dev mode
REDIS_URL=redis://localhost:6379
# Set to 'true' to require Redis (fail if unavailable)
REDIS_REQUIRED=false

# ─── Telegram MTProto ───────────────────────────────────────────────────────────
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# AES-256 key for encrypting stored Telegram session data (hex, 64 chars)
TELEGRAM_SESSION_ENCRYPTION_KEY=

# ─── Upload Configuration ──────────────────────────────────────────────────────
# Maximum file size in bytes (default: 2GB)
MAX_UPLOAD_SIZE=2147483648
# Per-user concurrent upload limit
MAX_CONCURRENT_UPLOADS_PER_USER=3
# Per-account concurrent upload limit
MAX_CONCURRENT_UPLOADS_PER_ACCOUNT=2
# Upload chunk size in bytes (default: 512KB)
UPLOAD_CHUNK_SIZE=524288

# ─── Download & Cloudflare Distributed Gateway ─────────────────────────────────
# Per-user concurrent download limit
MAX_CONCURRENT_DOWNLOADS_PER_USER=5
# Per-account concurrent download limit
MAX_CONCURRENT_DOWNLOADS_PER_ACCOUNT=5
# Per-share concurrent download limit
MAX_CONCURRENT_DOWNLOADS_PER_SHARE=10
# Per-API-key concurrent download limit
MAX_CONCURRENT_DOWNLOADS_PER_API_KEY=10
# Cloudflare Worker download gateway public URL (e.g. https://download.example.com or http://localhost:8787 for dev)
DOWNLOAD_GATEWAY_URL=http://localhost:8787
# HMAC-SHA-256 secret for signing short-lived download authorization tokens (min 32 chars)
DOWNLOAD_GATEWAY_SECRET=change-me-to-a-secure-download-gateway-secret-32-chars
# Optional secondary secret for zero-downtime key rotation
DOWNLOAD_GATEWAY_ROTATION_SECRET=
# Lifetime of download authorization tokens in seconds (default: 900 = 15 minutes)
DOWNLOAD_TOKEN_TTL_SECONDS=900
# Internal shared secret for Worker-to-Origin streaming requests
INTERNAL_STREAM_SECRET=change-me-to-a-secure-internal-stream-secret-32-chars
# Redirect direct browser downloads to the Cloudflare Worker Gateway
ENABLE_WORKER_DOWNLOAD_REDIRECT=false

# ─── Rate Limiting ──────────────────────────────────────────────────────────────
# Web API: requests per window
RATE_LIMIT_WEB_MAX=100
RATE_LIMIT_WEB_WINDOW_MS=60000
# Developer API: requests per window
RATE_LIMIT_DEV_MAX=60
RATE_LIMIT_DEV_WINDOW_MS=60000

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# ─── Developer API ──────────────────────────────────────────────────────────────
# Optional custom API domain (e.g., api.example.com)
DEVELOPER_API_DOMAIN=
# API key hash algorithm
API_KEY_HASH_ALGORITHM=sha256

# ─── Cache TTLs (seconds) ──────────────────────────────────────────────────────
CACHE_TTL_FILE_METADATA=300
CACHE_TTL_FOLDER_LISTING=120
CACHE_TTL_SHARE_LINK=600
CACHE_TTL_USER_QUOTA=60
CACHE_TTL_ACCOUNT_HEALTH=30

# ─── Queue Configuration ───────────────────────────────────────────────────────
# Maximum retries for failed upload jobs
UPLOAD_MAX_RETRIES=3
# Backoff delay base in ms
UPLOAD_BACKOFF_BASE_MS=5000
# Job lease timeout in seconds
JOB_LEASE_TIMEOUT_SECONDS=300

# ─── Storage ───────────────────────────────────────────────────────────────────
# Default user storage quota in bytes (default: 10GB)
DEFAULT_USER_QUOTA_BYTES=10737418240
# Account utilization threshold (0-1) before reducing new placements
ACCOUNT_UTILIZATION_THRESHOLD=0.85
