{
  "name": "teledrive-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TeleDrive backend — Node.js + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx ../scripts/benchmark-downloads.ts",
    "discord": "tsx ../scripts/manage-discord-users.ts"
  },
  "dependencies": {
    "@mtcute/node": "^0.19.1",
    "better-auth": "^1.2.8",
    "bullmq": "^5.34.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "mime-types": "^3.0.1",
    "mongoose": "^8.14.1",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
